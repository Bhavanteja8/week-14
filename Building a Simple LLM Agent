from langchain_core.tools import tool
from langchain_huggingface import ChatHuggingFace, HuggingFacePipeline
from transformers import pipeline
from langgraph.prebuilt import create_react_agent

print("===== WEEK 14: SIMPLE LLM AGENT =====")

# 2. Define the tool
@tool
def calculator(expression: str) -> str:
    """Calculate a basic mathematical expression. Input should be a valid Python math string like '245 * 786'."""
    try:
        # Simple eval for safe arithmetic operations
        result = eval(expression, {"__builtins__": {}})
        return str(result)
    except Exception as e:
        return f"Error: {e}"

# 3. Setup a free local LLM that supports tool calling
pipe = pipeline(
    "text-generation",
    model="Qwen/Qwen2.5-0.5B-Instruct",
    max_new_tokens=256,
    return_full_text=False
)

hf_llm = HuggingFacePipeline(pipeline=pipe)
llm = ChatHuggingFace(llm=hf_llm)

# 4. Create the ReAct agent
tools = [calculator]
agent = create_react_agent(
    model=llm,
    tools=tools,
    prompt="You are a helpful AI assistant. Use the calculator tool whenever a mathematical calculation is required."
)

question = "What is 245 multiplied by 786?"

print("\nUser Question:")
print(question)

# 5. Invoke the agent
try:
    response = agent.invoke(
        {
            "messages": [
                {
                    "role": "user",
                    "content": question
                }
            ]
        }
    )

    print("\n--- AGENT RESPONSE ---")
    print(response["messages"][-1].content.strip())

except Exception as e:
    print("\nError:", e)
